# Public Firebase web config for the production build (deepsea-roundup-ai-prod).
# These values ship in the site's JavaScript by design; they are not secrets.
# Used by: vite build --mode production  (client/vite.config.js reads env files from the repo root)
VITE_NODE_ENV=production
# Empty = call the API on the same site (Firebase Hosting routes /api/** to Cloud Run).
VITE_SERVER_URL_PRODUCTION=
VITE_FIREBASE_API_KEY_PRODUCTION=AIzaSyDF8bzslX6tGpyQT0v2-BO13_8vqucQczg
VITE_FIREBASE_AUTH_DOMAIN_PRODUCTION=deepsea-roundup-ai-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID_PRODUCTION=deepsea-roundup-ai-prod
VITE_FIREBASE_STORAGE_BUCKET_PRODUCTION=deepsea-roundup-ai-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID_PRODUCTION=543660026986
VITE_FIREBASE_APP_ID_PRODUCTION=1:543660026986:web:a0a2720e8f836ded99ae13
VITE_FIREBASE_MEASUREMENT_ID_PRODUCTION=G-2JBVT00H9T
