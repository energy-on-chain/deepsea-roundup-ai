# Public Firebase web config for the staging build (deepsea-roundup-ai-dev).
# These values ship in the site's JavaScript by design; they are not secrets.
# Used by: vite build --mode staging  (client/vite.config.js reads env files from the repo root)
VITE_NODE_ENV=staging
# Empty = call the API on the same site (Firebase Hosting routes /api/** to Cloud Run).
VITE_SERVER_URL_STAGING=
VITE_FIREBASE_API_KEY_STAGING=AIzaSyCoLDcgbu0VqGfvlKrpio7KOvZYn8RZa-0
VITE_FIREBASE_AUTH_DOMAIN_STAGING=deepsea-roundup-ai-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID_STAGING=deepsea-roundup-ai-dev
VITE_FIREBASE_STORAGE_BUCKET_STAGING=deepsea-roundup-ai-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID_STAGING=226560072341
VITE_FIREBASE_APP_ID_STAGING=1:226560072341:web:ee1eca3f0a45d50d28199c
VITE_FIREBASE_MEASUREMENT_ID_STAGING=G-FNR2QNF284
# Staging only: keep the Register buttons usable after the deadline, for testing.
VITE_REGISTRATION_TEST_MODE=true
