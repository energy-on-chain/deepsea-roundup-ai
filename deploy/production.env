# Non-secret settings for the production deploy (scripts/deploy.sh production).
# Secrets (Stripe, Resend) live in Google Secret Manager, never in this file.
PROJECT_ID=deepsea-roundup-ai-prod
REGION=us-central1
APP_ENV=production
STORAGE_BUCKET=deepsea-roundup-ai-prod.firebasestorage.app
CLIENT_URL=https://deepsearoundup.customtournamentsolutions.com
ADMIN_EMAILS=matthew@deepwaterdigital.tech,cody@arrowheadecology.com
EMAIL_FROM=notification@customtournamentsolutions.com
# 0 = scale to zero when idle. Set to 1 (or 2) for event week, then redeploy; back to 0 after.
MIN_INSTANCES=0
MAX_INSTANCES=20
REGISTRATION_TEST_MODE=false
# Identity the API runs as (has Firestore, Storage and Auth access; no key file needed).
RUNTIME_SA=firebase-adminsdk-fbsvc@deepsea-roundup-ai-prod.iam.gserviceaccount.com
