# Non-secret settings for the staging deploy (scripts/deploy.sh staging).
# Secrets (Stripe, Resend) live in Google Secret Manager, never in this file.
PROJECT_ID=deepsea-roundup-ai-dev
REGION=us-central1
APP_ENV=staging
STORAGE_BUCKET=deepsea-roundup-ai-dev.firebasestorage.app
CLIENT_URL=https://deepsea-roundup-ai-dev.web.app
ADMIN_EMAILS=matthew@deepwaterdigital.tech,cody@arrowheadecology.com
EMAIL_FROM=notification@customtournamentsolutions.com
# 0 = scale to zero when idle. Raise to 1 for event week in production.
MIN_INSTANCES=0
MAX_INSTANCES=5
# Lets checkout run outside the registration window, for testing. Staging only.
REGISTRATION_TEST_MODE=true
# Identity the API runs as (has Firestore, Storage and Auth access; no key file needed).
RUNTIME_SA=firebase-adminsdk-fbsvc@deepsea-roundup-ai-dev.iam.gserviceaccount.com
